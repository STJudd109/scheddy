# Enquire Solutions API Configuration
# Replace these values with your actual credentials and settings

# API key provided by Enquire Solutions (required)
NEXT_PUBLIC_ENQUIRE_API_KEY=your_api_key_here

# Community name exactly as registered in Enquire (required)
NEXT_PUBLIC_COMMUNITY_NAME=Sunny Acres Assisted Living

# Path to redirect after successful form submission (defaults to '/')
NEXT_PUBLIC_REDIRECT_PATH=/thank-you

# Delay in milliseconds before redirecting (defaults to 3000)
NEXT_PUBLIC_REDIRECT_DELAY=3000

# Override the default API endpoint (rarely needed)
# NEXT_PUBLIC_API_ENDPOINT=https://api2.enquiresolutions.com/2/Individual/

# Enable global duplicate checking (set to 'true' to enable)
# NEXT_PUBLIC_GLOBAL_DUPLICATE_CHECK=false

# Branding configuration (optional)
# NEXT_PUBLIC_PRIMARY_COLOR=#0066cc
# NEXT_PUBLIC_SECONDARY_COLOR=#f8f9fa
# NEXT_PUBLIC_LOGO_URL=/logo.svg
# NEXT_PUBLIC_BUTTON_TEXT=Request Appointment

# For multi-community deployments (optional)
# NEXT_PUBLIC_COMMUNITY_1_NAME=Sunny Acres Assisted Living
# NEXT_PUBLIC_COMMUNITY_2_NAME=Oakwood Estates
# NEXT_PUBLIC_COMMUNITY_3_NAME=Harbor Lights

# Note: All variables with NEXT_PUBLIC_ prefix will be exposed in the browser
# Do not include sensitive information in these variables beyond what's necessary
