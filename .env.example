# Enquire Solutions API Configuration
# Replace these values with your actual credentials and settings

# ---------------------------------------------------------------------------
#  Server-side configuration
#  (These variables are NOT exposed to the browser and should contain any
#  sensitive information such as API keys or private endpoints.)
# ---------------------------------------------------------------------------

# API key provided by Enquire Solutions (required – keep this private!)
ENQUIRE_API_KEY=your_api_key_here

# Override the default API endpoint (rarely needed)
# ENQUIRE_API_ENDPOINT=https://api2.enquiresolutions.com/2/Individual/

# Set to 'true' if you want the serverless API route to make real requests
# while in local development.  Default behaviour is:
#   - production  -> real API requests
#   - development -> mock responses
# ENABLE_API_IN_DEVELOPMENT=false

# Enable global duplicate checking when submitting to Enquire
# (set to 'true' to include ReferralType=0 in the payload)
# ENABLE_GLOBAL_DUPLICATE_CHECK=false

# Community name exactly as registered in Enquire (required)
NEXT_PUBLIC_COMMUNITY_NAME=Sunny Acres Assisted Living

# Path to redirect after successful form submission (defaults to '/')
NEXT_PUBLIC_REDIRECT_PATH=/thank-you

# Delay in milliseconds before redirecting (defaults to 3000)
NEXT_PUBLIC_REDIRECT_DELAY=3000

# Override the default API endpoint (rarely needed)
# NEXT_PUBLIC_API_ENDPOINT=https://api2.enquiresolutions.com/2/Individual/

# Enable global duplicate checking (set to 'true' to enable)
# NEXT_PUBLIC_GLOBAL_DUPLICATE_CHECK=false   # (client hint only – no sensitive data)

# Branding configuration (optional)
# NEXT_PUBLIC_PRIMARY_COLOR=#0066cc
# NEXT_PUBLIC_SECONDARY_COLOR=#f8f9fa
# NEXT_PUBLIC_LOGO_URL=/logo.svg
# NEXT_PUBLIC_BUTTON_TEXT=Request Appointment

# ---------------------------------------------------------------------------
#  Cloudflare Turnstile Anti-Spam (optional)
# ---------------------------------------------------------------------------
# To enable Turnstile, you need **two** keys:
#   1) NEXT_PUBLIC_TURNSTILE_SITE_KEY – public site-key, safe for the browser
#   2) TURNSTILE_SECRET_KEY           – secret key, only on the server
# If either key is missing the security check is **disabled** and the form
# behaves normally (useful for local development).
#
# Public key (exposed to the browser)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0xAAAAAA...

# Secret key (keep private on the server)
# TURNSTILE_SECRET_KEY=0xBBBBBB...

# Note: All variables with NEXT_PUBLIC_ prefix will be exposed in the browser
# Do NOT place sensitive information (like API keys) in variables prefixed with
# NEXT_PUBLIC_, because they will be embedded in the client-side bundle.

# ---------------------------------------------------------------------------
#  Multi-Community / White-Label Deployment
# ---------------------------------------------------------------------------
# The form can be embedded on many partner sites while sharing a single backend.
# Each community can have its own API key, endpoint, and duplicate-check flag.
# 1)  Provide the community name at runtime via the embed script/querystring
# 2)  Whitelist the communities allowed to submit into your account
# 3)  Optionally override credentials per community

# 1) Community whitelist  (comma-separated list or leave unset to allow all)
# ALLOWED_COMMUNITIES=Sunny Acres Assisted Living,Oakwood Estates,Harbor Lights

# 2) Numbered community names – useful for CMS build‐time injection on static pages
# COMMUNITY_1_NAME=Sunny Acres Assisted Living
# COMMUNITY_2_NAME=Oakwood Estates
# COMMUNITY_3_NAME=Harbor Lights

# 3) Per-community credentials  (replace spaces with underscores and UPPERCASE)
# ENQUIRE_API_KEY_SUNNY_ACRES_ASSISTED_LIVING=abc123
# ENQUIRE_API_ENDPOINT_SUNNY_ACRES_ASSISTED_LIVING=https://custom.api/sunny
# ENABLE_GLOBAL_DUPLICATE_CHECK_SUNNY_ACRES_ASSISTED_LIVING=true

# 4) Default credentials (used when community-specific vars are not set)
# Already defined above: ENQUIRE_API_KEY / ENQUIRE_API_ENDPOINT

# ---------------------------------------------------------------------------
#  Embedding Script Options
# ---------------------------------------------------------------------------
# The public/embed.js helper accepts extra attributes. If the script is hosted
# from a CDN / different sub-domain you may need to specify the base URL that
# the iframe should load from:
#
# EMBED_BASE_URL=https://forms.your-domain.com
# 
# Leaving this unset defaults to the origin where embed.js is served.

